{
  "name": "@ankhorage/auth-github",
  "version": "0.1.0",
  "description": "GitHub App OAuth transport adapter implementing the provider-neutral Ankhorage auth port.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/auth-github.git"
  },
  "homepage": "https://github.com/ankhorage/auth-github#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/auth-github/issues"
  },
  "keywords": [
    "ankhorage",
    "auth",
    "github",
    "github-app",
    "oauth",
    "adapter",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.2.18"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "docs": "paradox && ankhorage-prettier --write paradox README.md",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ankhorage/auth": "^0.1.3",
    "@ankhorage/contracts": "^26.4.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.47",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
